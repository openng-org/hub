  "private": true,
  "description": "Angular version constants, semver helpers and the official Node/TypeScript/RxJS compatibility matrix.",
  "homepage": "https://hub.openng.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openng-org/hub.git",
    "directory": "packages/core-angular-versions"
  },
