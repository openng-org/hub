{
  "name": "@openng/hub",
  "version": "0.0.0",
  "private": true,
  "description": "Angular Hub — community-driven Angular data, tools and events (hub.openng.org)",
  "homepage": "https://hub.openng.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openng-org/hub.git"
  },
  "bugs": {
    "url": "https://github.com/openng-org/hub/issues"
  },
  "keywords": [
    "angular",
    "community",
    "events",
    "caniuse",
    "releases",
    "openng"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,html,css,json,md,mjs,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,json,md,mjs,yaml,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "catalog:",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "prettier": "catalog:",
    "turbo": "^2.5.5",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.0"
  }
}
