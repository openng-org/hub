{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "description": "The Angular Hub site: hub.openng.org",
  "homepage": "https://hub.openng.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openng-org/hub.git",
    "directory": "apps/web"
  },
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "ng serve",
    "build": "ng build && node scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check-types": "tsc -p tsconfig.app.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "serve:ssr": "node dist/web/server/server.mjs",
    "a11y": "playwright test --config e2e/playwright.config.ts a11y.spec.ts",
    "lint": "eslint .",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-server": "catalog:",
    "@angular/router": "catalog:",
    "@angular/ssr": "catalog:",
    "@openng/core-angular-versions": "workspace:*",
    "@openng/data-angular-mcp": "workspace:*",
    "@openng/data-caniuse": "workspace:*",
    "@openng/data-community": "workspace:*",
    "@openng/data-releases": "workspace:*",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "express": "^5.1.0",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/express": "^5.0.1",
    "@types/node": "catalog:",
    "axe-core": "4.10.2",
    "jsdom": "catalog:",
    "playwright": "1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
