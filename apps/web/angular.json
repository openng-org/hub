{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["node_modules/@openng/icons/openng-icons.css", "src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1",
                "hub.openng.org",
                "*.openng.org",
                "*.vercel.app"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "conditions": ["module", "source", "production"]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "conditions": ["module", "source", "development"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "prebundle": {
              "exclude": [
                "@openng/data-caniuse",
                "@openng/core-angular-versions",
                "@openng/data-community",
                "@openng/data-libraries",
                "@openng/data-releases"
              ]
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": [
              "src/server/**/*.ts",
              "src/app/core/api/**/*.ts",
              "src/app/core/services/**/*.ts",
              "src/app/core/theme/theme.ts",
              "src/app/core/utils/**/*.ts",
              "src/app/features/community/pages/contribute/draft.ts"
            ],
            "coverageExclude": ["**/*.spec.ts"],
            "coverageReporters": ["text-summary", "lcov"],
            "coverageThresholds": { "statements": 85, "branches": 75, "functions": 85, "lines": 85 }
          }
        }
      }
    }
  }
}
